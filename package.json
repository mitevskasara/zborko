    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^20",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.19.2",
