  "description": "Зборко — a Macedonian word-of-the-day web app and dictionary API built with Next.js and Prisma.",
  "license": "MIT",
  "author": "Sara Mitevska",
  "repository": {
    "type": "git",
    "url": "https://github.com/mitevskasara/zborko.git"
  },
