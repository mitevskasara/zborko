# Connection string for the PostgreSQL database used by Prisma.
#
# You can get one by creating a Prisma Postgres instance:
#   npx prisma init --db
# or by pointing at any PostgreSQL database, e.g.:
#   DATABASE_URL="postgresql://user:password@localhost:5432/zborko"
DATABASE_URL="postgresql://user:password@localhost:5432/zborko"
