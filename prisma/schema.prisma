generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Zbor {
  id       Int    @id @default(autoincrement())
  zbor     String @db.VarChar(50)
  vid      String @db.VarChar(10)
  rod      Rod?
  znacenje String

  @@index([zbor])
  @@index([zbor, vid])
  @@map("zborovi")
}

enum Rod {
  машки
  женски
  среден
}
